    async def brave_search(self, query: str, max_results: int) -> List[SearchResult]:
        """Perform a Brave search and extract results"""
        try:
            logger.info(f"Performing Brave search for: {query}")
            
            # Get a new page
            page = await self.get_page()
            
            try:
                # Configure page timeouts
                page.set_default_timeout(30000)
                
                # Navigate to Brave Search with the query
                encoded_query = query.replace(' ', '+')
                await page.goto(f"https://search.brave.com/search?q={encoded_query}")
                
                # Wait for results to load
                await page.wait_for_load_state("domcontentloaded")
                await page.wait_for_selector("main")
                
                # Give extra time for dynamic content
                await asyncio.sleep(2)
                
                # Extract search results
                results = []
                
                # Target organic search results
                result_elements = await page.query_selector_all(".snippet")
                if not result_elements:
                    result_elements = await page.query_selector_all(".fdb")
                
                logger.info(f"Found {len(result_elements)} raw Brave search result elements")
                
                for i, element in enumerate(result_elements):
                    if i >= max_results:
                        break
                        
                    try:
                        # Extract title and URL
                        title_element = await element.query_selector(".snippet-title a, .title a")
                        title = await title_element.inner_text() if title_element else "No title"
                        url = await title_element.get_attribute("href") if title_element else None
                        
                        # Skip if no valid URL or Brave internal URL
                        if not url or not url.startswith("http") or "brave.com/search" in url:
                            continue
                            
                        # Extract snippet
                        snippet_element = await element.query_selector(".snippet-description, .description")
                        snippet = await snippet_element.inner_text() if snippet_element else "No description available"
                        
                        # Add the result
                        results.append(SearchResult(
                            title=title,
                            url=url,
                            snippet=snippet,
                            source_type="article",
                            metadata={
                                "search_engine": "brave",
                                "position": i + 1,
                                "query": query
                            }
                        ))
                    except Exception as e:
                        logger.warning(f"Error parsing Brave search result {i}: {str(e)}")
                
                logger.info(f"Successfully extracted {len(results)} Brave search results")
                return results
            finally:
                await page.close()
                
        except Exception as e:
            logger.error(f"Brave search error: {str(e)}")
            return []
    
    async def fetch_content(self, url: str) -> Dict[str, Any]:
        """Fetch and extract content from a URL"""
        try:
            logger.info(f"Fetching content from URL: {url}")
            
            # Get a new page
            page = await self.get_page()
            
            try:
                # Configure page timeouts and behavior
                page.set_default_timeout(45000)  # 45 seconds for longer content
                
                # Navigate to the URL
                response = await page.goto(url, wait_until="domcontentloaded")
                
                # Check if navigation was successful
                if not response or response.status >= 400:
                    logger.error(f"Failed to load page: HTTP {response.status if response else 'unknown'}")
                    return {
                        "content": f"Failed to load page. HTTP status: {response.status if response else 'unknown'}",
                        "title": "Error loading page",
                        "metadata": {"error": True, "status": response.status if response else None}
                    }
                
                # Wait for the page to stabilize
                await page.wait_for_load_state("networkidle")
                
                # Get the page title
                title = await page.title()
                
                # Extract metadata
                metadata = {
                    "url": url,
                    "fetch_time": datetime.now().isoformat(),
                    "content_type": response.headers.get("content-type", "unknown"),
                }
                
                # Take a screenshot for debugging
                debug_dir = "logs/debug_screenshots"
                os.makedirs(debug_dir, exist_ok=True)
                await page.screenshot(path=f"{debug_dir}/fetch_content_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png")
                
                # Extract the main content
                # Try different strategies to get the most relevant content
                content = ""
                
                # Strategy 1: Look for content in semantic HTML elements
                content_selectors = [
                    "article", "main", "#content", ".content", ".article", 
                    "#main-content", ".main-content", ".post-content", ".entry-content",
                    "[role='main']", ".story-content"
                ]
                
                for selector in content_selectors:
                    try:
                        elements = await page.query_selector_all(selector)
                        for element in elements:
                            element_text = await element.inner_text()
                            # Take the longest content found
                            if len(element_text) > len(content):
                                content = element_text
                                
                        if content and len(content) > 200:
                            logger.info(f"Found main content using selector: {selector}")
                            break
                    except Exception as e:
                        logger.debug(f"Error with content selector {selector}: {str(e)}")
                
                # Strategy 2: Try to remove navigation, headers, footers, etc.
                if not content or len(content) < 200:
                    try:
                        # Remove common non-content elements
                        remove_selectors = [
                            "header", "footer", "nav", "#header", "#footer", "#nav", 
                            ".header", ".footer", ".nav", ".sidebar", "#sidebar",
                            ".menu", "#menu", ".advertisement", ".ads", ".comments"
                        ]
                        
                        for selector in remove_selectors:
                            elements = await page.query_selector_all(selector)
                            for element in elements:
                                try:
                                    await page.evaluate("(element) => element.remove()", element)
                                except:
                                    pass
                        
                        # Get the body content after removing clutter
                        body = await page.query_selector("body")
                        if body:
                            content = await body.inner_text()
                            logger.info("Using filtered body text as content")
                    except Exception as e:
                        logger.error(f"Error in content filtering: {str(e)}")
                
                # Strategy 3: If all else fails, use the whole body
                if not content:
                    try:
                        body = await page.query_selector("body")
                        content = await body.inner_text() if body else ""
                        logger.info("Using full body text as content")
                    except Exception as e:
                        logger.error(f"Failed to get body content: {str(e)}")
                        content = "Failed to extract content from the page."
                
                # Clean up the content
                if content:
                    import re
                    # Remove excessive whitespace
                    content = re.sub(r'\s+', ' ', content)
                    # Remove consecutive line breaks
                    content = re.sub(r'\n{3,}', '\n\n', content)
                
                logger.info(f"Successfully fetched {len(content)} characters of content")
                
                return {
                    "content": content,
                    "title": title,
                    "metadata": metadata
                }
            finally:
                await page.close()
                
        except PlaywrightTimeoutError:
            logger.warning(f"Timeout while fetching content from {url}")
            return {
                "content": "Content fetch timed out",
                "title": "Timeout Error",
                "metadata": {"error": True, "reason": "timeout"}
            }
        except Exception as e:
            logger.error(f"Error fetching content: {str(e)}")
            return {
                "content": f"Error fetching content: {str(e)}",
                "title": "Error",
                "metadata": {"error": True, "reason": str(e)}
            }

# Global browser manager
browser_manager = None

@app.on_event("startup")
async def startup_event():
    global browser_manager
    browser_manager = PlaywrightBrowserManager()
    await browser_manager.initialize()
    logger.info("MCP Browser API started")

@app.on_event("shutdown")
async def shutdown_event():
    global browser_manager
    if browser_manager:
        await browser_manager.close()
    logger.info("MCP Browser API shut down")

@app.post("/search", response_model=SearchResponse)
async def search(request: SearchRequest):
    try:
        logger.info(f"Search request received: {request.dict()}")
        
        # Select the appropriate search engine
        if request.search_engine.lower() == "google":
            results = await browser_manager.google_search(request.query, request.max_results)
        elif request.search_engine.lower() == "bing":
            results = await browser_manager.bing_search(request.query, request.max_results)
        elif request.search_engine.lower() == "brave":
            results = await browser_manager.brave_search(request.query, request.max_results)
        else:
            logger.warning(f"Unsupported search engine: {request.search_engine}")
            raise HTTPException(status_code=400, detail=f"Unsupported search engine: {request.search_engine}")
        
        # Filter results by source_type if needed
        # Note: This would require content analysis for accurate filtering
        
        return SearchResponse(
            results=results,
            query=request.query,
            search_engine=request.search_engine,
            timestamp=datetime.now().isoformat()
        )
    except Exception as e:
        logger.error(f"Error in search endpoint: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Search error: {str(e)}")

@app.post("/fetch", response_model=FetchResponse)
async def fetch(request: FetchRequest):
    try:
        logger.info(f"Fetch request received for URL: {request.url}")
        content_data = await browser_manager.fetch_content(str(request.url))
        
        return FetchResponse(
            url=str(request.url),
            content=content_data["content"],
            title=content_data["title"],
            metadata=content_data["metadata"],
            timestamp=datetime.now().isoformat()
        )
    except Exception as e:
        logger.error(f"Error in fetch endpoint: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Fetch error: {str(e)}")

@app.get("/health")
async def health_check():
    """Health check endpoint to verify if the API is working"""
    return {
        "status": "healthy", 
        "time": datetime.now().isoformat(),
        "browser_status": "initialized" if browser_manager and browser_manager._initialized else "not_initialized"
    }

