# Request and response models
class SearchRequest(BaseModel):
    query: str
    max_results: int = 10
    source_types: Optional[List[str]] = ["article", "blog"]
    search_engine: str = "google"  # Options: google, bing, brave

class SearchResult(BaseModel):
    title: str
    url: str
    snippet: str
    content: str = ""
    source_type: str
    metadata: Dict[str, Any]

class SearchResponse(BaseModel):
    results: List[SearchResult]
    query: str
    search_engine: str
    timestamp: str

class FetchRequest(BaseModel):
    url: HttpUrl  # Using HttpUrl type for validation

class FetchResponse(BaseModel):
    url: str
    content: str
    title: str
    metadata: Dict[str, Any]
    timestamp: str

# Browser manager
class PlaywrightBrowserManager:
    def __init__(self):
        self.playwright = None
        self.browser = None
        self.context = None
        self._lock = asyncio.Lock()
        self._initialized = False
    
    async def initialize(self):
        """Initialize the Playwright browser instance asynchronously"""
        if self._initialized:
            return
        
        async with self._lock:
            if not self._initialized:
                logger.info("Initializing Playwright browser")
                try:
                    self.playwright = await async_playwright().start()
                    self.browser = await self.playwright.chromium.launch(
                        headless=True,  # Set to False to see the browser in action
                        args=[
                            "--disable-dev-shm-usage",
                            "--no-sandbox",
                            "--disable-setuid-sandbox",
                            "--disable-gpu",
                            "--disable-web-security",
                            "--disable-features=IsolateOrigins,site-per-process",
                        ]
                    )
                    
                    # Create a persistent context for better performance
                    self.context = await self.browser.new_context(
                        viewport={"width": 1920, "height": 1080},
                        user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/112.0.0.0 Safari/537.36",
                        java_script_enabled=True,
                    )
                    
                    self._initialized = True
                    logger.info("Playwright browser initialized successfully")
                except Exception as e:
                    logger.error(f"Failed to initialize Playwright browser: {str(e)}")
                    raise
    
    async def close(self):
        """Close all Playwright resources"""
        if self._initialized:
            logger.info("Closing Playwright browser")
            try:
                if self.context:
                    await self.context.close()
                if self.browser:
                    await self.browser.close()
                if self.playwright:
                    await self.playwright.stop()
                
                self._initialized = False
                logger.info("Playwright browser closed successfully")
            except Exception as e:
                logger.error(f"Error closing Playwright browser: {str(e)}")
    
    async def get_page(self):
        """Get a new page from the browser context"""
        if not self._initialized:
            await self.initialize()
        
        page = await self.context.new_page()
        return page
    
    async def google_search(self, query: str, max_results: int) -> List[SearchResult]:
        """Perform a Google search and extract results"""
        try:
            logger.info(f"Performing Google search for: {query}")
            
            # Get a new page
            page = await self.get_page()
            
            try:
                # Configure page timeouts
                page.set_default_timeout(30000)  # 30 seconds for all operations
                
                # Navigate to Google and perform search
                await page.goto("https://www.google.com/")
                
                # Accept cookies if the banner appears
                try:
                    accept_button = page.get_by_role("button", name="Accept all")
                    if await accept_button.is_visible(timeout=3000):
                        await accept_button.click()
                        await page.wait_for_load_state("networkidle")
                except Exception as e:
                    logger.debug(f"No cookie consent needed or error: {str(e)}")
                
                # Fill the search box and submit
                await page.fill('textarea[name="q"]', query)
                await page.press('textarea[name="q"]', 'Enter')
                
                # Wait for search results to load
                await page.wait_for_load_state("domcontentloaded")
                await page.wait_for_selector("#search")
                
                # Give some extra time for dynamic content
                await asyncio.sleep(2)
                
                # Take a screenshot for debugging
                debug_dir = "logs/debug_screenshots"
                os.makedirs(debug_dir, exist_ok=True)
                await page.screenshot(path=f"{debug_dir}/google_search_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png")
                
                # Extract search results
                results = []
                
                # Advanced CSS selector to target organic search results
                # This avoids ads and other non-result elements
                result_elements = await page.query_selector_all("div#search div.g")
                
                if not result_elements:
                    # Try alternative selector if the first one doesn't work
                    result_elements = await page.query_selector_all("#rso div.g, #search div[data-sokoban-container]")
                
                logger.info(f"Found {len(result_elements)} raw search result elements")
                
                for i, element in enumerate(result_elements):
                    if i >= max_results:
                        break
                        
                    try:
                        # Extract title
                        title_element = await element.query_selector("h3")
                        title = await title_element.inner_text() if title_element else "No title"
                        
                        # Extract URL
                        link_element = await element.query_selector("a")
                        url = await link_element.get_attribute("href") if link_element else None
                        
                        # Skip if no valid URL
                        if not url or not url.startswith("http"):
                            continue
                            
                        # Extract snippet
                        snippet_element = await element.query_selector("div[data-content-feature='1']")
                        if not snippet_element:
                            # Try alternative selector for the snippet
                            snippet_element = await element.query_selector("div.VwiC3b, div.yuRUbf + div")
                            
                        snippet = await snippet_element.inner_text() if snippet_element else "No description available"
                        
                        # Add the result to our list
                        results.append(SearchResult(
                            title=title,
                            url=url,
                            snippet=snippet,
                            source_type="article",  # Default, can be refined
                            metadata={
                                "search_engine": "google",
                                "position": i + 1,
                                "query": query
                            }
                        ))
                    except Exception as e:
                        logger.warning(f"Error parsing Google search result {i}: {str(e)}")
                
                logger.info(f"Successfully extracted {len(results)} Google search results")
                return results
            finally:
                # Always close the page when done
                await page.close()
                
        except Exception as e:
            logger.error(f"Google search error: {str(e)}")
            return []
    
